# Load necessary libraries
library(dplyr)
# Load and clean the dataset
data <- read.csv("diabetes_prediction_dataset.csv") %>%
na.omit() %>%          # Remove missing values
distinct()             # Remove duplicate rows
# Ensure consistent data types for clustering
data <- data %>%
mutate(
smoking_history = as.numeric(as.factor(smoking_history)), # Convert to numeric
hypertension = as.numeric(as.factor(hypertension))       # Convert to numeric
)
# Prepare data for clustering
clustering_data <- data %>%
select(bmi, smoking_history, hypertension) %>%
na.omit()
# Perform k-means clustering
set.seed(123)
kmeans_result <- kmeans(clustering_data, centers = 3)
# Add cluster labels to the clustering data
clustering_data$cluster <- as.factor(kmeans_result$cluster)
# Add cluster labels back to the original dataset
data_with_clusters <- data %>%
left_join(clustering_data, by = c("bmi", "smoking_history", "hypertension"))
# Save the updated dataset with clusters
write.csv(data_with_clusters, "data_with_clusters.csv", row.names = FALSE)
